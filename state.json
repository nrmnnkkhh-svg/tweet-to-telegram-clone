    "2082386370652258466": {
      "msg_id": 286,
      "last_tweet_id": "2082390240535208405",
      "text": "\u0634\u0628\u06a9\u0647 \u0628\u06cc\u200c\u0627\u0641\u200c\u0627\u0645\u200c\u062a\u06cc\u200c\u0648\u06cc \u06af\u0632\u0627\u0631\u0634 \u062f\u0627\u062f \u06a9\u0647 \u06a9\u0627\u0648\u06cc\u0646\u0633\u06a9\u06cc\u060c \u062f\u06cc\u200c\u062c\u06cc \u0641\u0631\u0627\u0646\u0633\u0648\u06cc\u060c \u062f\u0631\u06af\u0630\u0634\u062a\u0647 \u0627\u0633\u062a.\n\n\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\n\n\u06a9\u0627\u0648\u06cc\u0646\u0633\u06a9\u06cc\u060c \u062f\u06cc\u200c\u062c\u06cc \u0648 \u0645\u0648\u0633\u06cc\u0642\u06cc\u062f\u0627\u0646 \u0627\u0644\u06a9\u062a\u0631\u0648\u067e\u0627\u067e \u0641\u0631\u0627\u0646\u0633\u0648\u06cc \u06a9\u0647 \u0646\u0627\u0645 \u0627\u0635\u0644\u06cc \u0627\u0648 \u0648\u0646\u0633\u0627\u0646 \u0628\u0644\u0648\u0631\u0698\u0647 \u0628\u0648\u062f\u060c \u062f\u0631 \u067e\u0627\u0631\u06cc\u0633 \u062f\u0631\u06af\u0630\u0634\u062a.\n\n\u06a9\u0627\u0648\u06cc\u0646\u0633\u06a9\u06cc \u062e\u0627\u0644\u0642 \u0622\u0647\u0646\u06af \u0645\u0634\u0647\u0648\u0631 \u0646\u0627\u06cc\u062a\u200c\u06a9\u0627\u0644 \u062f\u0631 \u0633\u0627\u0644 \u06f2\u06f0\u06f1\u06f0 \u0628\u0648\u062f \u0648 \u062f\u0631 \u0645\u0631\u0627\u0633\u0645 \u0627\u0641\u062a\u062a\u0627\u062d\u06cc\u0647 \u0628\u0627\u0632\u06cc\u200c\u0647\u0627\u06cc \u0627\u0644\u0645\u067e\u06cc\u06a9 \u06f2\u06f0\u06f2\u06f4 \u0646\u06cc\u0632 \u0627\u062c\u0631\u0627 \u062f\u0627\u0634\u062a.\n\n\ud83c\udd94 @CloneIntlbrk"
