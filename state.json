    "2082435522509635791": {
      "msg_id": 312,
      "last_tweet_id": "2082435522509635791",
      "text": "\u06af\u0645\u0631\u06a9 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f \u0634\u06cc\u0648\u0647\u200c\u0646\u0627\u0645\u0647 \u062e\u062f\u0645\u0627\u062a \u06af\u0645\u0631\u06a9\u06cc \u0627\u0631\u0628\u0639\u06cc\u0646\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u0645\u0645\u0646\u0648\u0639\u06cc\u062a \u0631\u062c\u06cc\u0633\u062a\u0631\u06cc \u06af\u0648\u0634\u06cc \u062f\u0631 \u0645\u0631\u0632\u0647\u0627\u060c \u0647\u0645\u0686\u0646\u0627\u0646 \u062a\u0627 \u0627\u0637\u0644\u0627\u0639 \u062b\u0627\u0646\u0648\u06cc \u0645\u0639\u062a\u0628\u0631 \u0648 \u0644\u0627\u0632\u0645\u200c\u0627\u0644\u0627\u062c\u0631\u0627\u0633\u062a.\n\n\ud83c\udd94 @CloneIntlbrk"
