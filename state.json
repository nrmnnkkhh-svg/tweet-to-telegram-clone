    "2082392783524864035": {
      "msg_id": 287,
      "last_tweet_id": "2082395359116935182",
      "text": "\u0639\u0644\u06cc\u0631\u0636\u0627 \u0633\u0644\u06cc\u0645\u06cc\u060c \u0639\u0636\u0648 \u0647\u06cc\u0627\u062a \u0631\u06cc\u06cc\u0633\u0647 \u0645\u062c\u0644\u0633: \u0631\u0647\u0628\u0631\u06cc \u062a\u0646\u0647\u0627 \u0628\u062d\u062b \u0627\u0646\u062a\u0642\u0627\u0645 \u0631\u0627 \u0645\u0637\u0631\u062d \u0646\u06a9\u0631\u062f\u0647\u060c \u0628\u0644\u06a9\u0647 \u0645\u0648\u0636\u0648\u0639 \u0642\u0635\u0627\u0635 \u0647\u0645 \u062f\u0631 \u06a9\u0646\u0627\u0631 \u0627\u0646\u062a\u0642\u0627\u0645 \u0645\u0637\u0631\u062d \u0634\u062f\u0647 \u0627\u0633\u062a. \u0646\u0638\u0631 \u0645\u062c\u0644\u0633 \u0647\u0645 \u0628\u0631 \u0627\u0646\u062a\u0642\u0627\u0645 \u0648 \u0642\u0635\u0627\u0635 \u0627\u0633\u062a.\n\n\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\n\n\u0633\u0644\u06cc\u0645\u06cc\u060c \u0639\u0636\u0648 \u0647\u06cc\u0627\u062a \u0631\u06cc\u06cc\u0633\u0647 \u0645\u062c\u0644\u0633: \u062d\u06a9\u0645 \u062c\u0646\u0627\u06cc\u062a\u06a9\u0627\u0631\u0627\u0646 \u0645\u0627\u0646\u0646\u062f \u0633\u0644\u0645\u0627\u0646 \u0631\u0634\u062f\u06cc \u0627\u0633\u062a \u0648 \u0633\u0631\u0627\u0646 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0648 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644 \u00ab\u0645\u0647\u062f\u0648\u0631\u0627\u0644\u062f\u0648\u0645 \u0648 \u0648\u0627\u062c\u0628\u200c\u0627\u0644\u0642\u062a\u0644\u00bb \u0647\u0633\u062a\u0646\u062f.\n\n\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\n\n\u0633\u0644\u06cc\u0645\u06cc\u060c \u0639\u0636\u0648 \u0647\u06cc\u0627\u062a \u0631\u06cc\u06cc\u0633\u0647 \u0645\u062c\u0644\u0633: \u0628\u0631\u062e\u06cc \u0627\u0632 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0645\u0646\u0637\u0642\u0647 \u0627\u062f\u0628 \u0634\u062f\u0646\u062f\u060c \u0628\u0631\u062e\u06cc \u0627\u0632 \u0622\u0646\u200c\u0647\u0627 \u0647\u0645 \u0628\u0647\u200c\u0632\u0648\u062f\u06cc \u0627\u062f\u0628 \u0645\u06cc\u200c\u0634\u0648\u0646\