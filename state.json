      "text": "\u0631\u0648\u06cc\u062a\u0631\u0632 \u062e\u0628\u0631 \u062f\u0627\u062f \u06a9\u0647 \u0641\u0631\u0645\u0627\u0646\u062f\u0647 \u0633\u0646\u062a\u06a9\u0627\u0645 \u062f\u0631 \u0646\u0627\u0645\u0647\u200c\u0627\u06cc \u0628\u0647 \u0646\u06cc\u0631\u0648\u0647\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc \u0647\u0634\u062f\u0627\u0631 \u062f\u0627\u062f\u0647 \u06a9\u0647 \u0627\u0646\u062a\u0634\u0627\u0631 \u0648\u06cc\u062f\u06cc\u0648\u0647\u0627\u06cc \u0636\u0628\u0637\u200c\u0634\u062f\u0647 \u0628\u0627 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u062f\u0631 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0628\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0631\u0627\u06cc \u0647\u062f\u0641 \u0642\u0631\u0627\u0631 \u062f\u0627\u062f\u0646 \u067e\u0627\u06cc\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u06a9\u0645\u06a9 \u06a9\u0646\u062f.\n\n\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\n\n\u0631\u0648\u06cc\u062a\u0631\u0632 \u062e\u0628\u0631 \u062f\u0627\u062f \u06a9\u0647 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0645\u062d\u062f\u0648\u062f\u06cc\u062a\u200c\u0647\u0627\u06cc\u06cc \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u0628\u0631\u0627\u06cc \u0646\u06cc\u0631\u0648\u0647\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631 \u0645\u0646\u0637\u0642\u0647 \u0627\u06cc\u062c\u0627\u062f \u0634\u0648\u062f.\n\n\ud83c\udd94 @CloneIntlbrk"
    },
    "2082412929270284735": {
      "msg_id": 291,
      "last_tweet_id": "2082413914336211417",
      "text": "\u0645\u062f\u06cc\u0631\u06a9\u0644 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0628\u062d\u0631\u0627\u0646 \u0622\u0630\u0631\u0628\u0627\u06cc\u062c\u0627\u0646\u200c\u063a\u0631\u0628\u06cc\u060c \u0627\u0632 \u0627\u0635\u0627\u0628\u062a \u06cc\u06a9 \u0645\u0648\u0634\u06a9 \u0628\u0647 \u06cc\u06a9 \u00ab\u0645\u0646\u0637\u0642\u0647 \u062e\u0627\u0644\u06cc \u0627\u0632 \u0633\u06a9\u0646\u0647\u00bb \u062f\u0631 \u0627\u06cc\u0646 \u0627\u0633\u062a\u0627\u0646 \u062e\u0628\u0631 \u062f\u0627\u062f.\n\n\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\n\n\u067e\u06cc\u0634\u200c\u062a\u0631 \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u0645\u062d\u0644\u06cc\u060c \u0627\u0632 \u062d\u0645\u0644\u0627\u062a\u06cc \u0628\u0647 \u0645\u0646\u0627\u0637\u0642 \u0645\u0631\u0632\u06cc \u067e\u06cc\u0631\u0627\u0646\u0634\u0647\u0631 \u062e\u0628\u0631 \u062f\u0627\u062f\u0647 \u0628\u0648\u062f\u0646\u062f.\n\n\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\n\n\u062e\u0628\u0631\u06af\u0632\u0627\u0631\u06cc \u0635\u062f\u0627 \u0648 \u0633\u06cc\u0645\u0627 \u0646\u0648\u0634\u062a \u06a9\u0647 \u0638\u0647\u0631 \u0686\u0647\u0627\u0631\u0634\u0646\u0628\u0647\u060c \u0646\u0642\u0637\u0647\u200c\u0627\u06cc \u062f\u0631 \u0646\u0648\u0627\u0631 \u0645\u0631\u0632\u06cc \u067e\u06cc\u0631\u0627\u0646\u0634\u0647\u0631 \u0645\u0648\u0631\u062f \u062d\u0645\u0644\u0647 \u0647\u0648\u0627\u06cc\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0642\u0631\u0627\u0631 \u06af\u0631\u0641\u062a.\n\n\ud83c\udd94 @CloneIntlbrk"
    },
    "2082419814102929837": {
      "msg_id": 299,
      "last_tweet_id": "2082420017686016178",
      "text": "\u0639\u0628\u0627\u0633 \u0645\u0642\u062a\u062f\u0627\u06cc\u06cc\u060c \u0646\u0627\u06cc\u0628\u200c\u0631\u06cc\u06cc\u0633 \u06a9\u0645\u06cc\u0633\u06cc\u0648\u0646 \u0627\u0645\u0646\u06cc\u062a \u0645\u0644\u06cc \u0645\u062c\u0644\u0633: \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u06cc\u0634 \u0627\u0632 \u0647\u0631 \u0632\u0645\u0627\u0646 \u062f\u06cc\u06af\u0631\u06cc \u0628\u0647 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0627\u0631\u0648\u067e\u0627\u06cc\u06cc \u0647\u0634\u062f\u0627\u0631 \u0645\u06cc\u200c\u062f\u0647\u062f \u06a9\u0647 \u0627\u062a\u062e\u0627\u0630 \u00ab\u0631\u0641\u062a\u0627\u0631\u0647\u0627\u06cc \u0646\u0627\u0628\u062e\u0631\u062f\u0627\u0646\u0647\u00bb\u060c \u0627\u06cc\u0646 \u06a9\u0634\u0648\u0631\u0647\u0627 \u0631\u0627 \u06a9\u0647 \u0627\u0632 \u0646\u0638\u0631 \u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc\u06a9 \u0622\u0633\u06cc\u0628\u200c\u067e\u0630\u06cc\u0631 \u0647\u0633\u062a\u0646\u062f\u060c \u062f\u0631 \u0645\u0639\u0631\u0636 \u062e\u0637\u0631\u0627\u062a \u062c\u062f\u06cc \u0642\u0631\u0627\u0631 \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u062f.\n\n\u0645\u0642\u062a\u062f\u0627\u06cc\u06cc\u060c \u0646\u0627\u06cc\u0628\u200c\u0631\u06cc\u06cc\u0633 \u06a9\u0645\u06cc\u0633\u06cc\u0648\u0646 \u0627\u0645\u0646\u06cc\u062a \u0645\u0644\u06cc \u0645\u062c\u0644\u0633: \u0627\u062a\u062d\u0627\u062f\u06cc\u0647 \u0627\u0631\u0648\u067e\u0627 \u0628\u0627\u06cc\u062f \u0628\u0647 \u0639\u0642\u0644\u0627\u0646\u06cc\u062a \u0628\u0627\u0632\u06af\u0631\u062f\u062f \u0648 \u0627\u0632 \u0647\u0631\u06af\u0648\u0646\u0647 \u062a\u062d\u0631\u06cc\u06a9 \u06cc\u0627 \u0627\u06cc\u062c\u0627\u062f \u062a\u0646\u0634 \u062e\u0648\u062f\u062f\u0627\u0631\u06cc \u06a9\u0646\u062f.\n\n\ud83c\udd94 @CloneIntlbrk"
    },
    "2082421389299011958": {
      "msg_id": 300,
      "last_tweet_id": "2082421633629733112",
      "text": "\u0648\u0632\u0627\u0631\u062a \u062e\u0627\u0631\u062c\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u0631 \u0628\u06cc\u0627\u0646\u06cc\u0647\u200c\u0627\u06cc\u060c \u062d\u0645\u0644\u0627\u062a \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0648 \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc \u0628\u0647 \u0628\u0631\u062e\u06cc \u0645\u0646\u0627\u0637\u0642 \u062f\u0631 \u0639\u0631\u0627\u0642 \u0631\u0627 \u0645\u062d\u06a9\u0648\u0645 \u06a9\u0631\u062f.\n\n\u0648\u0632\u0627\u0631\u062a \u062e\u0627\u0631\u062c\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u0631 \u0628\u06cc\u0627\u0646\u06cc\u0647 \u062e\u0648\u062f \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f \u06a9\u0647 \u062f\u0631 \u062d\u0645\u0644\u0627\u062a \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0648 \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc \u0628\u0647 \u0627\u0647\u062f\u0627\u0641\u06cc \u062f\u0631 \u0639\u0631\u0627\u0642\u060c \u00ab\u0645\u0648\u0627\u06a9\u0628 \u0648 \u0627\u06cc\u0633\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u0632\u0627\u0626\u0631\u0627\u0646 \u0627\u0631\u0628\u0639\u06cc\u0646\u00bb\u060c \u0647\u062f\u0641 \u062d\u0645\u0644\u0647 \u0642\u0631\u0627\u0631 \u06af\u0631\u0641\u062a\u0647 \u0627\u0633\u062a.\n\n\ud83c\udd94 @CloneIntlbrk"
    },
    "2082400416608731273": {
      "msg_id": 302,
      "last_tweet_id": "2082426030980026783",
      "text": "\u0627\u0631\u062a\u0634 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f \u062d\u0632\u0628\u200c\u0627\u0644\u0644\u0647 \u06cc\u06a9 \u067e\u0647\u067e\u0627\u062f \u0631\u0627 \u0628\u0647 \u0633\u0645\u062a \u06cc\u06a9 \u062e\u0648\u062f\u0631\u0648 \u062f\u0631 \u062f\u0627\u062e\u0644 \u0645\u0646\u0637\u0642\u0647 \u0627\u0645\u0646\u06cc\u062a\u06cc \u062f\u0631 \u062c\u0646\u0648\u0628 \u0644\u0628\u0646\u0627\u0646\u060c \u067e\u0631\u062a\u0627\u0628 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a.\n\n\u0627\u0631\u062a\u0634 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f \u062d\u0645\u0644\u0647 \u062d\u0632\u0628\u200c\u0627\u0644\u0644\u0647 \u0646\u0642\u0636 \u0622\u0634\u06a9\u0627\u0631 \u062a\u0648\u0627\u0641\u0642 \u0622\u062a\u0634\u200c\u0628\u0633 \u062f\u0631 \u0644\u0628\u0646\u0627\u0646 \u0627\u0633\u062a.\n\n\ud83c\udd94 @CloneIntlbrk"
