    "2082394609548669158": {
      "msg_id": 288,
      "last_tweet_id": "2082394802037879050",
      "text": "\u0648\u0632\u0627\u0631\u062a \u062e\u0627\u0631\u062c\u0647 \u0628\u062d\u0631\u06cc\u0646 \u062a\u0644\u0627\u0634\u200c \u0646\u06cc\u0631\u0648\u0647\u0627\u06cc \u0646\u06cc\u0627\u0628\u062a\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u0631 \u0639\u0631\u0627\u0642 \u0628\u0631\u0627\u06cc \u0647\u062f\u0641 \u0642\u0631\u0627\u0631 \u062f\u0627\u062f\u0646 \u062a\u0627\u0633\u06cc\u0633\u0627\u062a \u0646\u0641\u062a\u06cc \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc \u0631\u0627 \u062a\u0634\u062f\u06cc\u062f\u06cc \u062e\u0637\u0631\u0646\u0627\u06a9 \u062f\u0627\u0646\u0633\u062a \u0648 \u062a\u0627\u06a9\u06cc\u062f \u06a9\u0631\u062f \u0627\u0632 \u0647\u0645\u0647 \u0627\u0642\u062f\u0627\u0645\u200c\u0647\u0627\u06cc \u0627\u06cc\u0646 \u06a9\u0634\u0648\u0631 \u0628\u0631\u0627\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062d\u0627\u06a9\u0645\u06cc\u062a\u060c \u0627\u0645\u0646\u06cc\u062a \u0648 \u062b\u0628\u0627\u062a \u062e\u0648\u062f\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u062d\u0642 \u067e\u0627\u0633\u062e \u0628\u0647 \u0645\u0646\u0628\u0639 \u062d\u0645\u0644\u0627\u062a \u062d\u0645\u0627\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u062f.\n\n\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\u2796\n\n\u0648\u0632\u0627\u0631\u062a \u062e\u0627\u0631\u062c\u0647 \u0628\u062d\u0631\u06cc\u0646 \u0647\u0645\u0686\u0646\u06cc\u0646 \u0627\u0632 \u062c\u0627\u0645\u0639\u0647 \u062c\u0647\u0627\u0646\u06cc\u060c \u0628\u0647 \u0648\u06cc\u0698\u0647 \u0634\u0648\u0631\u0627\u06cc \u0627\u0645\u0646\u06cc\u062a \u0633\u0627\u0632\u0645\u0627\u0646 \u0645\u0644\u0644\u060c \u062e\u0648\u0627\u0633\u062a \u0628\u0627 \u0635\u062f\u0648\u0631 \u0642\u0637\u0639\u0646\u0627\u0645\u0647\u200c\u0627\u06cc \u0641\u0648\u0631\u06cc\u060c \u062d\u0645\u0644\u0627\u062a \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0648 \u06af\u0631\u0648\u0647\u200c\u0647\u0627\u06cc \u0646\u06cc\u0627\u0628\u062a\u06cc\u200c\u0627\u0634 \u0639\u0644\u06cc\u0647 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0645\u0646\u0637\u0642\u0647 \u0631\u0627 \u0645\u062d\u06a9\u0648\u0645 \u06a9\u0646\u062f \u0648 \u062e\u0648\u0627\u0633\u062a\u0627\u0631 \u062a\u0648\u0642\u0641 \u0641\u0648\u0631\u06cc \u0627\u06cc\u0646 \u062d\u0645\u0644\u0627\u062a \u0634\u0648\u062f.\n\n\ud83c\udd94 @CloneIntlbrk"
