    "2082442592122261896": {
      "msg_id": 313,
      "last_tweet_id": "2082443076795085121",
      "text": "\u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e \u062f\u0631 \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u0628\u0627 \u0641\u0627\u06a9\u0633 \u0646\u06cc\u0648\u0632 \u062f\u0631\u0628\u0627\u0631\u0647 \u062d\u0645\u0644\u0627\u062a \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0647 \u0627\u0631\u062f\u0646 \u06af\u0641\u062a: \u062d\u0633\u0627\u0628\u06cc \u0646\u0627\u0628\u0648\u062f\u0634\u0627\u0646 \u062e\u0648\u0627\u0647\u06cc\u0645 \u06a9\u0631\u062f. \u0636\u0631\u0628\u0627\u062a \u0633\u062e\u062a\u06cc \u0628\u0647 \u0622\u0646\u0647\u0627 \u062e\u0648\u0627\u0647\u06cc\u0645 \u0632\u062f \u0648 \u0628\u0647\u200c\u0634\u062f\u062a \u062a\u0646\u0628\u06cc\u0647 \u062e\u0648\u0627\u0647\u0646\u062f \u0634\u062f.\n\n\u0631\u06cc\u06cc\u0633\u200c\u062c\u0645\u0647\u0648\u0631 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0647\u0645\u0686\u0646\u06cc\u0646 \u0627\u06cc\u0646 \u0634\u0628\u0647\u200c\u0646\u0638\u0627\u0645\u06cc\u0627\u0646 \u0631\u0627 \u00ab\u0633\u0631\u0637\u0627\u0646\u06cc \u0628\u0631\u0627\u06cc \u062c\u0647\u0627\u0646\u00bb \u062a\u0648\u0635\u06cc\u0641 \u06a9\u0631\u062f \u0648 \u06af\u0641\u062a \u062f\u0631 \u062d\u0627\u0644 \u0628\u0631\u0631\u0633\u06cc \u0635\u062f\u0648\u0631 \u0647\u0634\u062f\u0627\u0631\u0647\u0627\u06cc \u0628\u06cc\u0634\u062a\u0631 \u0639\u0644\u06cc\u0647 \u0646\u06cc\u0631\u0648\u0647\u0627\u06cc \u0646\u06cc\u0627\u0628\u062a\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0648 \u0627\u0631\u062a\u0628\u0627\u0637 \u0622\u0646\u0647\u0627 \u0628\u0627 \u062d\u06a9\u0648\u0645\u062a \u0627\u06cc\u0631\u0627\u0646 \u0627\u0633\u062a.\n\n\u062a\u0631\u0627\u0645\u067e \u0647\u0645\u0686\u0646\u06cc\u0646 \u062f\u0631 \u0627\u06cc\u0646 \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u0627\u0641\u0632\u0648\u062f \u062d\u0627\u0644\u0627 \u0645\u0648\u0636\u0639 \u0628\u0646\u06cc\u0627\u0645\u06cc\u0646 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648 \u062f\u0631\u0628\u0627\u0631\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0631\u0627 \u062f\u0631\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u0645. \u062a\u0631\u0627\u0645\u067e \u062f\u0631 \u0628\u062e\u0634 \u062f\u06cc\u06af\u0631\u06cc \u0627\u0632 \u06af\u0641\u062a\u200c\u0648\u06af\u0648\u060c \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u062d\u062a\u0645\u0627\u0644 \u0627\u062f\u0627\u0645\u0647 \u0645\u0630\u0627\u06a9\u0631\u0627\u062a \u0628\u0627 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u06af\u0641\u062a: \u0627\u062c\u0627\u0632\u0647 \u0645\u06cc\u200c\u062f\u0647\u06cc\u0645 \u0628\u0647 \u06af\u0641\u062a\u200c\u0648\u06af\u0648\u0647\u0627\u06cc\u0634\u0627\u0646 \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u0646\u062f.\n\n\ud83c\udd94 @CloneIntlbrk"
