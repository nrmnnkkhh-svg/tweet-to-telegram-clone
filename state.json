    "2083588503326081152": {
      "msg_id": 886,
      "last_tweet_id": "2083588900509843700",
      "texts": [
        "\u0645\u062d\u0645\u062f \u0645\u0631\u0646\u062f\u06cc\u060c \u0641\u0639\u0627\u0644 \u0631\u0633\u0627\u0646\u0647\u200c\u0627\u06cc \u0646\u0632\u062f\u06cc\u06a9 \u0628\u0647 \u062d\u06a9\u0648\u0645\u062a \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u0631 \u0627\u06cc\u06a9\u0633 \u0646\u0648\u0634\u062a \u06a9\u0647 \u0627\u06af\u0631 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u063a\u06cc\u0631\u0646\u0638\u0627\u0645\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0647\u062f\u0641 \u062d\u0645\u0644\u0647 \u0642\u0631\u0627\u0631 \u06af\u06cc\u0631\u062f\u060c \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0639\u0631\u0628\u06cc \u06a9\u0647 \u0627\u0632 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062d\u0645\u0627\u06cc\u062a \u06a9\u0631\u062f\u0647\u200c\u0627\u0646\u062f\u060c \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0637\u0631\u0641\u200c\u0647\u0627\u06cc \u06a9\u0627\u0645\u0644 \u062f\u0631 \u062c\u0646\u06af \u062a\u0644\u0642\u06cc \u062e\u0648\u0627\u0647\u0646\u062f \u0634\u062f \u0648 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u062e\u0648\u062f\u0634\u0627\u0646 \u0646\u06cc\u0632 \u0628\u0647\u200c\u0633\u0631\u0639\u062a \u0628\u0627 \u0646\u0627\u0628\u0648\u062f\u06cc \u06a9\u0627\u0645\u0644 \u0645\u0648\u0627\u062c\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.",
        "\u0645\u062d\u0645\u062f \u0645\u0631\u0646\u062f\u06cc: \u0628\u0631 \u0627\u0633\u0627\u0633 \u0627\u0638\u0647\u0627\u0631\u0627\u062a \u062f\u0648\u0644\u062a \u062a\u0631\u0627\u0645\u067e\u060c \u0628\u0647 \u0646\u0638\u0631 \u0645\u06cc\u200c\u0631\u0633\u062f \u06a9\u0627\u0645\u0644\u0627 \u0645\u062d\u062a\u0645\u0644 \u0627\u0633\u062a \u06a9\u0647 \u067e\u0633 \u0627\u0632 \u0645\u0627\u0647\u200c\u0647\u0627 \u062a\u0647\u062f\u06cc\u062f\u060c \u0627\u0645\u0634\u0628 \u0622\u062e\u0631\u06cc\u0646 \u0634\u0628 \u0639\u0627\u062f\u06cc \u062f\u0631 \u0642\u0637\u0631\u060c \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc\u060c \u06a9\u0648\u06cc\u062a\u060c \u0628\u062d\u0631\u06cc\u0646\u060c \u0627\u0645\u0627\u0631\u0627\u062a \u0645\u062a\u062d\u062f\u0647 \u0639\u0631\u0628\u06cc \u0648 \u0634\u0627\u06cc\u062f \u0639\u0645\u0627\u0646 \u0628\u0627\u0634\u062f. \u0627\u06af\u0631 \u062d\u0645\u0644\u0627\u062a\u06cc \u0639\u0644\u06cc\u0647 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u063a\u06cc\u0631\u0646\u0638\u0627\u0645\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0627\u0646\u062c\u0627\u0645 \u0634\u0648\u062f\u060c \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u062d\u06cc\u0627\u062a\u06cc \u0627\u06cc\u0646 \u062d\u06a9\u0648\u0645\u062a\u200c\u0647\u0627\u06cc \u0647\u0645\u062f\u0633\u062a\u060c \u062f\u0631 \u06a9\u0646\u0627\u0631 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u0627\u0633\u0631\u0627\u0626\u06cc\u0644 \u0648 \u0627\u062d\u062a\u0645\u0627\u0644\u0627 \u0627\u0631\u062f\u0646\u060c \u0646\u0627\u0628\u0648\u062f \u062e\u0648\u0627\u0647\u062f \u0634\u062f. \u0645\u0631\u062f\u0645 \u062f\u0631 \u0627\u06cc\u0646 \u06a9\u0634\u0648\u0631\u0647\u0627 \u0628\u0627\u06cc\u062f \u0641\u0648\u0631\u0627 \u0628\u0631\u0627\u06cc \u062a\u062e\u0644\u06cc\u0647 \u0622\u0645\u0627\u062f\u0647 \u0634\u0648\u0646\u062f."
      ],
      "combined": "\ud83d\udd34 &lt;Important&gt;\n\u0645\u062d\u0645\u062f \u0645\u0631\u0646\u062f\u06cc\u060c \u0641\u0639\u0627\u0644 \u0631\u0633\u0627\u0646\u0647\u200c\u0627\u06cc \u0646\u0632\u062f\u06cc\u06a9 \u0628\u0647 \u062d\u06a9\u0648\u0645\u062a \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u0631 \u0627\u06cc\u06a9\u0633 \u0646\u0648\u0634\u062a \u06a9\u0647 \u0627\u06af\u0631 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u063a\u06cc\u0631\u0646\u0638\u0627\u0645\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0647\u062f\u0641 \u062d\u0645\u0644\u0647 \u0642\u0631\u0627\u0631 \u06af\u06cc\u0631\u062f\u060c \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0639\u0631\u0628\u06cc \u06a9\u0647 \u0627\u0632 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062d\u0645\u0627\u06cc\u062a \u06a9\u0631\u062f\u0647\u200c\u0627\u0646\u062f\u060c \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0637\u0631\u0641\u200c\u0647\u0627\u06cc \u06a9\u0627\u0645\u0644 \u062f\u0631 \u062c\u0646\u06af \u062a\u0644\u0642\u06cc \u062e\u0648\u0627\u0647\u0646\u062f \u0634\u062f \u0648 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u062e\u0648\u062f\u0634\u0627\u0646 \u0646\u06cc\u0632 \u0628\u0647\u200c\u0633\u0631\u0639\u062a \u0628\u0627 \u0646\u0627\u0628\u0648\u062f\u06cc \u06a9\u0627\u0645\u0644 \u0645\u0648\u0627\u062c\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.\n\n\u0645\u062d\u0645\u062f \u0645\u0631\u0646\u062f\u06cc: \u0628\u0631 \u0627\u0633\u0627\u0633 \u0627\u0638\u0647\u0627\u0631\u0627\u062a \u062f\u0648\u0644\u062a \u062a\u0631\u0627\u0645\u067e\u060c \u0628\u0647 \u0646\u0638\u0631 \u0645\u06cc\u200c\u0631\u0633\u062f \u06a9\u0627\u0645\u0644\u0627 \u0645\u062d\u062a\u0645\u0644 \u0627\u0633\u062a \u06a9\u0647 \u067e\u0633 \u0627\u0632 \u0645\u0627\u0647\u200c\u0647\u0627 \u062a\u0647\u062f\u06cc\u062f\u060c \u0627\u0645\u0634\u0628 \u0622\u062e\u0631\u06cc\u0646 \u0634\u0628 \u0639\u0627\u062f\u06cc \u062f\u0631 \u0642\u0637\u0631\u060c \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc\u060c \u06a9\u0648\u06cc\u062a\u060c \u0628\u062d\u0631\u06cc\u0646\u060c \u0627\u0645\u0627\u0631\u0627\u062a \u0645\u062a\u062d\u062f\u0647 \u0639\u0631\u0628\u06cc \u0648 \u0634\u0627\u06cc\u062f \u0639\u0645\u0627\u0646 \u0628\u0627\u0634\u062f. \u0627\u06af\u0631 \u062d\u0645\u0644\u0627\u062a\u06cc \u0639\u0644\u06cc\u0647 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u063a\u06cc\u0631\u0646\u0638\u0627\u0645\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0627\u0646\u062c\u0627\u0645 \u0634\u0648\u062f\u060c \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u062d\u06cc\u0627\u062a\u06cc \u0627\u06cc\u0646 \u062d\u06a9\u0648\u0645\u062a\u200c\u0647\u0627\u06cc \u0647\u0645\u062f\u0633\u062a\u060c \u062f\u0631 \u06a9\u0646\u0627\u0631 \u0632\u06cc\u0631\u0633\u0627\u062e\u062a\u200c\u0647\u0627\u06cc \u0627\u0633\u0631\u0627\u0626\u06cc\u0644 \u0648 \u0627\u062d\u062a\u0645\u0627\u0644\u0627 \u0627\u0631\u062f\u0646\u060c \u0646\u0627\u0628\u0648\u062f \u062e\u0648\u0627\u0647\u062f \u0634\u062f. \u0645\u0631\u062f\u0645 \u062f\u0631 \u0627\u06cc\u0646 \u06a9\u0634\u0648\u0631\u0647\u0627 \u0628\u0627\u06cc\u062f \u0641\u0648\u0631\u0627 \u0628\u0631\u0627\u06cc \u062a\u062e\u0644\u06cc\u0647 \u0622\u0645\u0627\u062f\u0647 \u0634\u0648\u0646\u062f.\n\n\ud83c\udd94 @CloneIntlbrk",
